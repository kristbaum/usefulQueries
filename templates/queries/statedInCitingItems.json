{
  "id": "statedInCitingItems",
  "example": "Q42",
  "scope": "value",
  "section": "references",
  "propertyId": ["P248"],
  "valueId": null,
  "template": [
    "# Items with statements sourced from this work, ranked by how many of",
    "# their statements cite it. Large sources are sampled (first 2000 statements).",
    "SELECT ?item ?itemLabel ?statements WHERE {",
    "  {",
    "    SELECT ?item (COUNT(DISTINCT ?statement) AS ?statements) WHERE {",
    "      {",
    "        SELECT ?statement WHERE {",
    "          ?reference pr:{propertyId} wd:{valueId}.",
    "          ?statement prov:wasDerivedFrom ?reference.",
    "        }",
    "        LIMIT 2000",
    "      }",
    "      # A statement IRI starts with the ID of its item (wds:Q42-…). Reading the",
    "      # item off it is much faster than joining back via ?item ?p ?statement.",
    "      BIND(IRI(CONCAT(STR(wd:), UCASE(STRBEFORE(STRAFTER(STR(?statement), \"/statement/\"), \"-\")))) AS ?item)",
    "    }",
    "    GROUP BY ?item",
    "  }",
    "  SERVICE wikibase:label { bd:serviceParam wikibase:language \"[AUTO_LANGUAGE],en\". }",
    "}",
    "ORDER BY DESC(?statements)",
    "LIMIT 500"
  ],
  "emoji": "📚",
  "title": "Items citing {valueLabel}"
}
